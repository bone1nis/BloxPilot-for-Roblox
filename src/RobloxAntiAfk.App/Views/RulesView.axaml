<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobloxAntiAfk.App.ViewModels"
             xmlns:presentation="using:RobloxAntiAfk.App.Presentation"
             x:Class="RobloxAntiAfk.App.Views.RulesView"
             x:DataType="vm:RulesViewModel">
  <StackPanel Spacing="22">
    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="Оставь приложение открытым, и Roblox будет считать, что ты за компьютером." />
    <ItemsControl ItemsSource="{Binding Sections}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="22" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="presentation:RuleSection">
          <StackPanel>
            <TextBlock Classes="sectionTitle" Text="{Binding Title}" />
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="presentation:RuleItem">
                  <Border Classes="card" Classes.warning="{Binding IsWarning}">
                    <StackPanel Spacing="1">
                      <TextBlock Classes="strong" Text="{Binding Title}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted small" Text="{Binding Text}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
