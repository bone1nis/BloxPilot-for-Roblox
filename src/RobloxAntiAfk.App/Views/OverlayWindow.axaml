<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RobloxAntiAfk.App.Views.OverlayWindow"
        Title="BloxPilot"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Focusable="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <Panel>
    <Image x:Name="Frozen" IsVisible="False" Stretch="Fill" />
    <Border x:Name="Dim" IsVisible="False" Background="#33000000" />
    <Canvas x:Name="FrameArea" IsVisible="False">
      <Border x:Name="Frame" BorderThickness="2" BorderBrush="#4DA3FF" Background="#264DA3FF" />
    </Canvas>
    <Border x:Name="Card" IsVisible="False" VerticalAlignment="Top" CornerRadius="10" Padding="14,10" Background="#F0111622">
      <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="15" LineHeight="21" Foreground="White" />
    </Border>
  </Panel>
</Window>
