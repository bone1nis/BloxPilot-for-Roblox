<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RobloxAntiAfk.App.Presentation"
             xmlns:vm="using:RobloxAntiAfk.App.ViewModels"
             xmlns:views="using:RobloxAntiAfk.App.Views"
             x:Class="RobloxAntiAfk.App.Views.TranslationView"
             x:DataType="vm:TranslationViewModel">
  <StackPanel Spacing="8">
    <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel>
          <TextBlock Classes="strong" Text="{l:T 'Переводить текст из игры'}" />
          <TextBlock Classes="muted small" Text="{l:T 'Читает выбранную часть экрана и показывает русский текст рядом с ней. В Roblox ничего не внедряется'}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" />
      </Grid>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsEnabled}">
      <StackPanel Spacing="8">
        <TextBlock Classes="strong" Text="{l:T 'Где читать'}" />
        <WrapPanel>
          <Button Content="{Binding AreaButtonText}" IsVisible="{Binding ShowAreaButton}" Command="{Binding AreaButtonCommand}" Margin="0,0,8,0" />
          <Button Content="{Binding TranslateButtonText}" IsEnabled="{Binding CanTranslate}" Command="{Binding TranslateButtonCommand}" />
        </WrapPanel>
        <TextBlock Classes="muted small" Text="{Binding AreaHint}" />
        <TextBlock Classes="muted small" Classes.warning="{Binding IsStatusWarning}" Text="{Binding StatusText}" />
        <TextBlock Classes="muted small" IsVisible="{Binding HasDetail}" Text="{Binding Detail}" />
        <Button HorizontalAlignment="Left" IsVisible="{Binding ShowPermission}" Content="{l:T 'Открыть настройки macOS'}" Command="{Binding OpenPermissionSettingsCommand}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsEnabled}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel>
          <TextBlock Classes="strong" Text="{l:T 'Выделять каждый раз'}" />
          <TextBlock Classes="muted small" Text="{l:T 'Сочетание каждый раз предлагает обвести текст заново. Если выключить, приложение запомнит одну область и будет читать её сразу'}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectEachTime}" />
      </Grid>
    </Border>

    <Border Classes="card" IsVisible="{Binding HasResult}">
      <StackPanel Spacing="8">
        <TextBlock Classes="strong" Text="{l:T 'Последний перевод'}" />
        <SelectableTextBlock TextWrapping="Wrap" Text="{Binding TranslatedText}" />
        <SelectableTextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding SourceText}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsEnabled}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel>
          <TextBlock Classes="strong" Text="{l:T 'Обновлять самому'}" />
          <TextBlock Classes="muted small" Text="{l:T 'Пока перевод показан, область читается раз в 2 секунды. В сервис текст уходит, только когда меняется'}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRefresh}" />
      </Grid>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsEnabled}">
      <StackPanel>
        <TextBlock Classes="strong" Text="{l:T 'Горячая клавиша'}" />
        <TextBlock Classes="muted small" Text="{Binding HotkeyHint}" />
        <views:HotkeyEditor DataContext="{Binding HotkeyEditor}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsEnabled}">
      <StackPanel Spacing="8">
        <TextBlock Classes="strong" Text="{l:T 'Ключ DeepL, если есть'}" />
        <TextBox PlaceholderText="{l:T 'Необязательно'}" PasswordChar="•" Text="{Binding DeepLKey}" />
        <TextBlock Classes="muted small" Text="{l:T 'Без ключа работают бесплатные сервисы: Google Translate и MyMemory. У Google это неофициальный адрес, он может перестать отвечать. Ключ хранится на этом компьютере в файле настроек.'}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsEnabled}">
      <StackPanel Spacing="4">
        <TextBlock Classes="strong" Text="{l:T 'Что уходит в интернет'}" />
        <TextBlock Classes="muted small" Text="{l:T 'Только распознанный текст, снимки остаются на компьютере. Если в области окажется чат или ник, они тоже уйдут в сервис перевода. Экран читается, только пока Roblox на переднем плане.'}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
