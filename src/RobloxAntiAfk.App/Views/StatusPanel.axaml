<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:RobloxAntiAfk.App.Presentation"
             xmlns:vm="using:RobloxAntiAfk.App.ViewModels"
             x:Class="RobloxAntiAfk.App.Views.StatusPanel"
             x:DataType="vm:StatusViewModel">
  <Border x:Name="Root"
          Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="0,0,1,0"
          Padding="24"
          Classes.stopped="{Binding IsStopped}"
          Classes.waiting="{Binding IsWaiting}"
          Classes.problem="{Binding IsProblem}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="16">
      <Panel Grid.Row="0" Width="196" Height="196" HorizontalAlignment="Center">
        <Ellipse Stroke="{DynamicResource RaisedBrush}" StrokeThickness="10" />
        <Arc Classes="ring" SweepAngle="{Binding RingSweep}" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Center" FontWeight="SemiBold"
                     FontSize="46" IsVisible="{Binding ShowCountdown}" />
          <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Center" FontWeight="SemiBold"
                     FontSize="22" IsVisible="{Binding !ShowCountdown}" />
          <TextBlock Text="{l:T 'до следующего действия'}" Classes="muted" FontSize="12" HorizontalAlignment="Center"
                     IsVisible="{Binding ShowCountdown}" />
        </StackPanel>
      </Panel>

      <StackPanel Grid.Row="1" Spacing="2">
        <TextBlock Classes="stateTitle" Text="{Binding Title}" />
        <TextBlock Classes="muted" FontSize="13" Text="{Binding Subtitle}" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="2" ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
        <Button Grid.ColumnSpan="3" Classes="primary" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                Content="{l:T 'Открыть настройки доступа'}"
                IsVisible="{Binding NeedsPermission}"
                Command="{Binding OpenPermissionSettingsCommand}" />
        <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"
                Classes.primary="{Binding IsStopped}"
                Content="{Binding RunButtonText}" IsEnabled="{Binding CanToggleRunning}"
                Command="{Binding ToggleRunningCommand}" />
        <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"
                Content="{l:T 'Сделать сейчас'}" IsEnabled="{Binding CanRunNow}"
                Command="{Binding RunNowCommand}" />
      </Grid>

      <Grid Grid.Row="3" ColumnDefinitions="*,8,*">
        <Border Grid.Column="0" Classes="stat">
          <StackPanel>
            <TextBlock Text="{Binding ActionsDone}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{l:T 'действий сделано'}" Classes="muted" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="stat">
          <StackPanel>
            <TextBlock Text="{Binding ActiveTime}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{l:T 'время работы'}" Classes="muted" FontSize="12" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="4">
        <TextBlock Classes="muted" FontSize="12" FontWeight="SemiBold" Text="{l:T 'Последние действия'}" />
        <TextBlock Grid.Row="1" Classes="muted" FontSize="12.5" Text="{l:T 'Пока ничего не было'}"
                   IsVisible="{Binding !HasActivity}" />
        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasActivity}">
          <ItemsControl ItemsSource="{Binding Activity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActivityItem">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,2">
                  <Ellipse Classes="dot" Classes.success="{Binding IsSuccess}"
                           Classes.skipped="{Binding IsSkipped}" Classes.error="{Binding IsError}" />
                  <TextBlock Grid.Column="1" Classes="muted" FontSize="12.5" Text="{Binding Time}" />
                  <TextBlock Grid.Column="2" FontSize="12.5" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</UserControl>
