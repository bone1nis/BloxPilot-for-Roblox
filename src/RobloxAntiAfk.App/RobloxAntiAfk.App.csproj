<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RobloxAntiAFK</AssemblyName>
    <Product>BloxPilot</Product>
    <AssemblyTitle>BloxPilot</AssemblyTitle>
    <RootNamespace>RobloxAntiAfk.App</RootNamespace>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <!-- В сборку для Mac распознавание для Windows не входит: там его заменяет Vision из самой macOS. -->
  <PropertyGroup Condition="!$(RuntimeIdentifier.StartsWith('osx'))">
    <DefineConstants>$(DefineConstants);WINDOWS_OCR</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('osx'))">
    <ProjectReference Include="..\RobloxAntiAfk.Ocr\RobloxAntiAfk.Ocr.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/icon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RobloxAntiAfk.Core\RobloxAntiAfk.Core.csproj" />
    <ProjectReference Include="..\RobloxAntiAfk.Platform.Windows\RobloxAntiAfk.Platform.Windows.csproj" />
    <ProjectReference Include="..\RobloxAntiAfk.Platform.Mac\RobloxAntiAfk.Platform.Mac.csproj" />
  </ItemGroup>
</Project>
