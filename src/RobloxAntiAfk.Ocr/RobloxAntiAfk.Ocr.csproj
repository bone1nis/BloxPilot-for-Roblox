<Project Sdk="Microsoft.NET.Sdk">
  <!-- Распознавание для Windows. В сборку для Mac не входит: там работает Vision из самой macOS. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RapidOcrNet" GeneratePathProperty="true" ExcludeAssets="build" />
    <PackageReference Include="ThinkGeo.Dependency.MicrosoftVisualCRunTime140" ExcludeAssets="build" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RobloxAntiAfk.Core\RobloxAntiAfk.Core.csproj" />
  </ItemGroup>
  <!-- Модели зашиты в сборку, чтобы приложение оставалось одним файлом exe. -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgRapidOcrNet)/models/v5/*" LogicalName="models/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
